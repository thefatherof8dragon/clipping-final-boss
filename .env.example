# ====================================================================
# Clipping Final Boss - Local Environment Configuration
# All keys are OPTIONAL. The app works 100% locally with zero keys.
# Copy this file to .env and fill in your keys if desired.
# ====================================================================

# LLM Providers (for AI viral titles, hooks, and hashtags)
# Supported: gemini, openai, groq, anthropic, ollama, local
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_URL=http://127.0.0.1:11434

# Audio Transcription Engine
# Supported: local_whisper (offline faster-whisper), openai_whisper (cloud)
TRANSCRIPTION_OPTION=local_whisper
# Model size for faster-whisper: tiny, base, small, medium
WHISPER_MODEL=base

# YouTube OAuth & Upload Automation (Optional)
# Follow the guided wizard in Settings to obtain credentials
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
AUTO_UPLOAD=false
DAILY_UPLOAD_CAP=6

# Live Stream Monitoring Settings
RECORD_HEIGHT=720
SPIKE_MIN_MSGS=120
